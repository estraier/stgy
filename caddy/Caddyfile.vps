(cgi_rate_limit) {
  rate_limit {
    zone cgi_per_ip {
      match {
        path_regexp cgi_rate_limit_path ^.*\.cgi(/.*)?$
      }
      key {http.request.host}:{remote_host}
      events 120
      window 1h
    }
    log_key
  }
}

import extra-sites/*.caddy

https://stgy.jp {
  encode zstd gzip

  header {
    Content-Security-Policy "frame-ancestors 'none'"
    X-Frame-Options "DENY"
  }

  @unexpected_image_request {
    header Sec-Fetch-Dest image
    not path /_next/image /_next/static/* /apple-touch-icon.png /data/* /favicon.ico /favicon.svg /icons/*
  }

  import cgi_rate_limit

  rate_limit {
    zone geo_per_ip {
      match {
        path /backend/geo/encode /backend/geo/encode/ /backend/geo/decode /backend/geo/decode/
      }
      key {remote_host}
      events 60
      window 1h
    }
    zone search_per_ip {
      match {
        path /backend/posts/search /backend/posts/search/ /backend/posts/kwic-pub /backend/posts/kwic-pub/
      }
      key {remote_host}
      events 60
      window 1h
    }
    zone captcha_per_ip {
      match {
        path /backend/captcha/challenge /backend/captcha/challenge/ /backend/captcha/verify /backend/captcha/verify/
      }
      key {remote_host}
      events 60
      window 1h
    }
    zone pub_comment_post_per_ip {
      match {
        method POST
        path /backend/pub-comments /backend/pub-comments/
      }
      key {remote_host}
      events 20
      window 1h
    }
    log_key
  }

  rate_limit {
    zone stgy_per_ip {
      match {
        not path /_next/static/*
        not path_regexp stgy_cgi_path ^.*\.cgi(/.*)?$
      }
      key {remote_host}
      events {$STGY_CADDY_RATE_LIMIT_EVENTS:120}
      window {$STGY_CADDY_RATE_LIMIT_WINDOW:5m}
    }
    log_key
  }

  @deny_backend_metrics path /backend/metrics /backend/metrics/
  route {
    respond @unexpected_image_request 404

    import site_test

    respond @deny_backend_metrics 404

    redir /backend /backend/
    handle_path /backend/* {
      reverse_proxy http://backend:3100 {
        lb_policy first
        health_uri /health
        header_up Host {http.request.host}
      }
    }

    handle {
      reverse_proxy http://frontend:3000 {
        lb_policy first
        health_uri /
        header_up Host {http.request.host}
      }
    }
  }
}

https://s3.stgy.jp {
  encode zstd gzip

  @okref header_regexp Referer ^https?://([^.]+\.)?stgy\.jp(/|$)
  @noref not header Referer *
  handle @okref {
    reverse_proxy http://minio:9000 {
      flush_interval -1
    }
  }
  handle @noref {
    reverse_proxy http://minio:9000 {
      flush_interval -1
    }
  }
  respond 403
}

https://s3-console.stgy.jp {
  encode zstd gzip

  reverse_proxy http://minio:9001
}
